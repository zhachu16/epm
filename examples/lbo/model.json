        },
        {
          "metric": "sponsor_equity",
          "label": "Sponsor equity"
        },
        {
          "metric": "total_sources",
          "style": "total"
        },
        {
          "header": "Uses"
        },
        {
          "metric": "enterprise_value",
          "label": "Purchase of the business"
        },
        {
          "metric": "transaction_fees"
        },
        {
          "metric": "financing_fees"
        },
        {
          "metric": "minimum_cash",
          "label": "Cash to balance sheet"
        },
        {
          "metric": "total_uses",
          "style": "total"
        }
      ]
    },
    "income_statement": {
      "axis": "fy",
      "folder": "Income statement",
      "rows": [
        {
          "metric": "revenue"
        },
        {
          "metric": "cogs"
        },
        {
          "metric": "gross_profit",
          "style": "subtotal"
        },
        {
          "metric": "sga"
        },
        {
          "metric": "ebitda",
          "style": "subtotal"
        },
        {
          "metric": "depreciation_amortization"
        },
        {
          "metric": "ebit",
          "style": "subtotal"
        },
        {
          "metric": "interest_expense"
        },
        {
          "metric": "ebt",
          "style": "subtotal"
        },
        {
          "metric": "taxes"
        },
        {
          "metric": "net_income",
          "style": "total"
        }
      ]
    },

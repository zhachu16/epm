{
  "settings": {
    "name": "Project Atlas LBO",
    "currency": "USD",
    "default_axis": "fy",
    "key_outputs": [
      "equity_irr",
      "moic",
      "equity_irr_3y"
    ]
  },
  "axes": {
    "fy": {
      "values": [
        2022,
        2023,
        2024,
        2025,
        2026,
        2027,
        2028,
        2029,
        2030
      ],
      "historical": [
        2022,
        2023,
        2024
      ],
      "label": "Fiscal year (deal closes at the end of 2024)"
    }
  },
  "sources": {
    "is": {
      "file": "inputs/historicals.xlsx",
      "sheet": "IS",
      "axis": "fy",
      "description": "Historical income statement"
    },
    "bs": {
      "file": "inputs/historicals.xlsx",
      "sheet": "BS",
      "axis": "fy",
      "description": "Historical balance sheet"
    },
    "deal": {
      "file": "inputs/historicals.xlsx",
      "sheet": "Deal",
      "description": "Deal terms"
    }
  },
  "metrics": {
    "revenue_growth": {
      "axis": "fy",
      "unit": "%",
      "folder": "Assumptions/Operations",
      "value": {
        "2025": 0.08,
        "2026": 0.07,
        "2027": 0.06,
        "2028": 0.05,
        "2029": 0.05,
        "2030": 0.04
      },
      "scope": "forecast"
    },
    "gross_margin": {
      "unit": "%",
      "folder": "Assumptions/Operations",
      "value": 0.42
    },
    "sga_pct_revenue": {
      "unit": "%",
      "folder": "Assumptions/Operations",
      "value": 0.19
    },
    "da_pct_revenue": {
      "unit": "%",
      "folder": "Assumptions/Operations",
      "value": 0.04
    },
    "capex_pct_revenue": {
      "unit": "%",
      "folder": "Assumptions/Operations",
      "value": 0.045
    },
    "dso": {
      "unit": "days",
      "folder": "Assumptions/Operations",
      "description": "Receivable days",
      "value": 50.0
    },
    "dio": {
      "unit": "days",
      "folder": "Assumptions/Operations",
      "description": "Inventory days",
      "value": 60.0
    },
    "dpo": {
      "unit": "days",
      "folder": "Assumptions/Operations",
      "description": "Payable days",
      "value": 40.0
    },
    "tax_rate": {
      "unit": "%",
      "folder": "Assumptions/Operations",
      "value": 0.25
    },
    "entry_multiple": {
      "unit": "x",
      "folder": "Assumptions/Transaction",
      "input": {
        "source": "deal",
        "cell": "B2"
      }
    },
    "transaction_fee_pct": {
      "unit": "%",
      "folder": "Assumptions/Transaction",
      "input": {
        "source": "deal",
        "cell": "B3"
      }
    },
    "financing_fee_pct": {
      "unit": "%",
      "folder": "Assumptions/Transaction",
      "input": {
        "source": "deal",
        "cell": "B4"
      }
    },
    "minimum_cash": {
      "unit": "USD m",
      "folder": "Assumptions/Transaction",
      "value": 30.0
    },
    "exit_multiple": {
      "unit": "x",
      "folder": "Assumptions/Transaction",
      "value": 9.0
    },
    "tlb_leverage": {
      "unit": "x",
      "folder": "Assumptions/Financing",
      "description": "Term loan B, x LTM EBITDA",
      "value": 4.0
    },
    "notes_leverage": {
      "unit": "x",
      "folder": "Assumptions/Financing",
      "description": "Senior notes, x LTM EBITDA",
      "value": 1.5
    },
    "interest_rate": {
      "unit": "%",
      "folder": "Assumptions/Financing",
      "description": "Base rate (SOFR)",
      "value": 0.04
    },
    "tlb_spread": {
      "unit": "%",
      "folder": "Assumptions/Financing",
      "value": 0.035
    },
    "revolver_spread": {
      "unit": "%",
      "folder": "Assumptions/Financing",
      "value": 0.03
    },
    "notes_rate": {
      "unit": "%",
      "folder": "Assumptions/Financing",
      "description": "Fixed coupon",
      "value": 0.085
    },
    "tlb_amortization_pct": {
      "unit": "%",
      "folder": "Assumptions/Financing",
      "value": 0.01
    },
    "tlb_sweep_pct": {
      "unit": "%",
      "folder": "Assumptions/Financing",
      "description": "Share of excess cash swept to the term loan",
      "value": 0.75
    },
    "ltm_ebitda": {
      "unit": "USD m",
      "folder": "Transaction",
      "formula": "at(ebitda, 2024)"
    },
    "enterprise_value": {
      "unit": "USD m",
      "folder": "Transaction",
      "formula": "entry_multiple * ltm_ebitda"
    },
    "tlb_amount": {
      "unit": "USD m",
      "folder": "Transaction",
      "formula": "tlb_leverage * ltm_ebitda"
    },
    "notes_amount": {
      "unit": "USD m",
      "folder": "Transaction",
      "formula": "notes_leverage * ltm_ebitda"
    },
    "transaction_fees": {
      "unit": "USD m",
      "folder": "Transaction",
      "formula": "transaction_fee_pct * enterprise_value"
    },
    "financing_fees": {
      "unit": "USD m",
      "folder": "Transaction",
      "formula": "financing_fee_pct * (tlb_amount + notes_amount)"
    },
    "total_uses": {
      "unit": "USD m",
      "folder": "Transaction",
      "formula": "enterprise_value + transaction_fees + financing_fees + minimum_cash"
    },
    "sponsor_equity": {
      "unit": "USD m",
      "folder": "Transaction",
      "formula": "total_uses - tlb_amount - notes_amount"
    },
    "total_sources": {
      "unit": "USD m",
      "folder": "Transaction",
      "formula": "tlb_amount + notes_amount + sponsor_equity"
    },
    "net_assets_acquired": {
      "unit": "USD m",
      "folder": "Transaction",
      "formula": "at(receivables, 2024) + at(inventory, 2024) - at(payables, 2024) + at(ppe, 2024)"
    },
    "goodwill": {
      "unit": "USD m",
      "folder": "Transaction",
      "formula": "enterprise_value - net_assets_acquired"
    },
    "equity_at_close": {
      "unit": "USD m",
      "folder": "Transaction",
      "description": "Fees are expensed at close",
      "formula": "sponsor_equity - transaction_fees - financing_fees"
    },
    "revenue": {
      "unit": "USD m",
      "folder": "Income statement",
      "formula": "prev(revenue) * (1 + revenue_growth)",
      "history": {
        "source": "is",
        "item": "Revenue"
      }
    },
    "cogs": {
      "unit": "USD m",
      "folder": "Income statement",
      "formula": "revenue * (1 - gross_margin)",
      "history": {
        "source": "is",
        "item": "Cost of goods sold"
      }
    },
    "gross_profit": {
      "unit": "USD m",
      "folder": "Income statement",
      "formula": "revenue - cogs"
    },
    "sga": {
      "unit": "USD m",
      "folder": "Income statement",
      "formula": "revenue * sga_pct_revenue",
      "history": {
        "source": "is",
        "item": "SG&A"
      }
    },
    "ebitda": {
      "unit": "USD m",
      "folder": "Income statement",
      "formula": "gross_profit - sga"
    },
    "depreciation_amortization": {
      "unit": "USD m",
      "folder": "Income statement",
      "formula": "revenue * da_pct_revenue",
      "history": {
        "source": "is",
        "item": "Depreciation & amortization"
      }
    },
    "ebit": {
      "unit": "USD m",
      "folder": "Income statement",
      "formula": "ebitda - depreciation_amortization"
    },
    "interest_expense": {
      "unit": "USD m",
      "folder": "Income statement",
      "formula": "tlb_interest + notes_interest + revolver_interest",
      "history": {
        "source": "is",
        "item": "Interest expense"
      }
    },
    "ebt": {
      "unit": "USD m",
      "folder": "Income statement",
      "formula": "ebit - interest_expense"
    },
    "taxes": {
      "unit": "USD m",
      "folder": "Income statement",
      "formula": "max(ebt, 0) * tax_rate",
      "history": {
        "source": "is",
        "item": "Income tax"
      }
    },
    "net_income": {
      "unit": "USD m",
      "folder": "Income statement",
      "formula": "ebt - taxes"
    },
    "receivables": {
      "unit": "USD m",
      "folder": "Balance sheet",
      "formula": "revenue * dso / 365",
      "history": {
        "source": "bs",
        "item": "Accounts receivable"
      }
    },
    "inventory": {
      "unit": "USD m",
      "folder": "Balance sheet",
      "formula": "cogs * dio / 365",
      "history": {
        "source": "bs",
        "item": "Inventory"
      }
    },
    "payables": {
      "unit": "USD m",
      "folder": "Balance sheet",
      "formula": "cogs * dpo / 365",
      "history": {
        "source": "bs",
        "item": "Accounts payable"
      }
    },
    "nwc": {
      "unit": "USD m",
      "folder": "Balance sheet",
      "formula": "receivables + inventory - payables"
    },
    "capex": {
      "unit": "USD m",
      "folder": "Cash flow",
      "formula": "revenue * capex_pct_revenue",
      "scope": "forecast"
    },
    "ppe": {
      "unit": "USD m",
      "folder": "Balance sheet",
      "formula": "prev(ppe) + capex - depreciation_amortization",
      "history": {
        "source": "bs",
        "item": "PP&E, net"
      }
    },
    "change_in_nwc": {
      "unit": "USD m",
      "folder": "Cash flow",
      "formula": "nwc - prev(nwc)",
      "scope": "forecast"
    },
    "cfo": {
      "unit": "USD m",
      "folder": "Cash flow",
      "description": "Cash from operations",
      "formula": "net_income + depreciation_amortization - change_in_nwc"
    },
    "fcf": {
      "unit": "USD m",
      "folder": "Cash flow",
      "description": "Free cash flow before debt service",
      "formula": "cfo - capex"
    },
    "tlb_amortization": {
      "unit": "USD m",
      "folder": "Debt",
      "description": "Scheduled repayment from the custom function",
      "formula": "amortization_schedule(tlb_amount, tlb_amortization_pct, is_forecast())"
    },
    "tlb_open": {
      "unit": "USD m",
      "folder": "Debt",
      "formula": "prev(tlb_close, init=tlb_amount)"
    },
    "tlb_mandatory": {
      "unit": "USD m",
      "folder": "Debt",
      "formula": "min(tlb_amortization, tlb_open)"
    },
    "cash_available_for_sweep": {
      "unit": "USD m",
      "folder": "Debt",
      "formula": "prev(cash, init=minimum_cash) + fcf - tlb_mandatory - minimum_cash"
    },
    "excess_cash": {
      "unit": "USD m",
      "folder": "Debt",
      "formula": "max(cash_available_for_sweep, 0)"
    },
    "revolver_open": {
      "unit": "USD m",
      "folder": "Debt",
      "formula": "prev(revolver_close, init=0)"
    },
    "revolver_draw": {
      "unit": "USD m",
      "folder": "Debt",
      "formula": "max(-cash_available_for_sweep, 0)"
    },
    "revolver_repayment": {
      "unit": "USD m",
      "folder": "Debt",
      "formula": "min(excess_cash, revolver_open)"
    },
    "revolver_close": {
      "unit": "USD m",
      "folder": "Debt",
      "formula": "revolver_open + revolver_draw - revolver_repayment",
      "scope": "forecast"
    },
    "tlb_sweep": {
      "unit": "USD m",
      "folder": "Debt",
      "formula": "clip(min(tlb_sweep_pct * (excess_cash - revolver_repayment), tlb_open - tlb_mandatory), lower=0)"
    },
    "tlb_close": {
      "unit": "USD m",
      "folder": "Debt",
      "formula": "tlb_open - tlb_mandatory - tlb_sweep",
      "scope": "forecast"
    },
    "notes_close": {
      "axis": "fy",
      "unit": "USD m",
      "folder": "Debt",
      "description": "Bullet repayment at maturity, after the forecast",
      "formula": "prev(notes_close, init=notes_amount)",
      "scope": "forecast"
    },
    "notes_open": {
      "unit": "USD m",
      "folder": "Debt",
      "formula": "prev(notes_close, init=notes_amount)"
    },
    "tlb_rate": {
      "unit": "%",
      "folder": "Debt",
      "formula": "interest_rate + tlb_spread"
    },
    "revolver_rate": {
      "unit": "%",
      "folder": "Debt",
      "formula": "interest_rate + revolver_spread"
    },
    "tlb_interest": {
      "unit": "USD m",
      "folder": "Debt",
      "formula": "tlb_rate * (tlb_open + tlb_close) / 2"
    },
    "notes_interest": {
      "unit": "USD m",
      "folder": "Debt",
      "formula": "notes_rate * (notes_open + notes_close) / 2"
    },
    "revolver_interest": {
      "unit": "USD m",
      "folder": "Debt",
      "formula": "revolver_rate * (revolver_open + revolver_close) / 2"
    },
    "total_debt": {
      "unit": "USD m",
      "folder": "Debt",
      "formula": "tlb_close + notes_close + revolver_close"
    },
    "leverage": {
      "unit": "x",
      "folder": "Debt",
      "description": "Total debt / EBITDA",
      "formula": "total_debt / ebitda"
    },
    "cash": {
      "unit": "USD m",
      "folder": "Balance sheet",
      "formula": "prev(cash, init=minimum_cash) + fcf - tlb_mandatory - tlb_sweep + revolver_draw - revolver_repayment",
      "scope": "forecast"
    },
    "goodwill_balance": {
      "axis": "fy",
      "unit": "USD m",
      "folder": "Balance sheet",
      "formula": "goodwill",
      "scope": "forecast"
    },
    "equity": {
      "unit": "USD m",
      "folder": "Balance sheet",
      "formula": "prev(equity, init=equity_at_close) + net_income",
      "scope": "forecast"
    },
    "total_assets": {
      "unit": "USD m",
      "folder": "Balance sheet",
      "formula": "cash + receivables + inventory + ppe + goodwill_balance"
    },
    "total_liabilities_and_equity": {
      "unit": "USD m",
      "folder": "Balance sheet",
      "formula": "payables + total_debt + equity"
    },
    "exit_ev": {
      "unit": "USD m",
      "folder": "Returns",
      "description": "Exit after 5 years",
      "formula": "exit_multiple * at(ebitda, 2029)"
    },
    "exit_net_debt": {
      "unit": "USD m",
      "folder": "Returns",
      "formula": "at(total_debt, 2029) - at(cash, 2029)"
    },
    "exit_equity_value": {
      "unit": "USD m",
      "folder": "Returns",
      "formula": "exit_ev - exit_net_debt"
    },
    "moic": {
      "unit": "x",
      "folder": "Returns",
      "formula": "exit_equity_value / sponsor_equity"
    },
    "equity_cash_flows": {
      "axis": "fy",
      "unit": "USD m",
      "folder": "Returns",
      "formula": "where(period() == 2024, -sponsor_equity, where(period() == 2029, exit_equity_value, 0))"
    },
    "equity_irr": {
      "unit": "%",
      "folder": "Returns",
      "formula": "irr(equity_cash_flows)"
    },
    "exit_equity_value_3y": {
      "unit": "USD m",
      "folder": "Returns",
      "description": "Exit after 3 years",
      "formula": "exit_multiple * at(ebitda, 2027) - (at(total_debt, 2027) - at(cash, 2027))"
    },
    "moic_3y": {
      "unit": "x",
      "folder": "Returns",
      "formula": "exit_equity_value_3y / sponsor_equity"
    },
    "equity_irr_3y": {
      "unit": "%",
      "folder": "Returns",
      "formula": "moic_3y ** (1 / 3) - 1"
    }
  },
  "circularities": {
    "average_balance_interest": {
      "metrics": [
        "interest_expense",
        "tlb_interest",
        "revolver_interest",
        "ebt",
        "taxes",
        "net_income",
        "cfo",
        "fcf",
        "cash_available_for_sweep",
        "excess_cash",
        "revolver_draw",
        "revolver_repayment",
        "revolver_close",
        "tlb_sweep",
        "tlb_close"
      ],
      "description": "Interest on average debt balances depends on the cash sweep, which depends on interest."
    }
  },
  "tables": {

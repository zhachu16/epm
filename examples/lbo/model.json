  "analyses": {
    "entry_exit_irr": {
      "inputs": [
        {
          "metric": "entry_multiple",
          "values": [
            8.0,
            8.5,
            9.0,
            9.5,
            10.0
          ]
        },
        {
          "metric": "exit_multiple",
          "values": [
            8.0,
            8.5,
            9.0,
            9.5,
            10.0
          ]
        }
      ],
      "outputs": [
        "equity_irr",
        "moic"
      ],
      "plot": {
        "kind": "heatmap",
        "x": "entry_multiple",
        "y": "exit_multiple",
        "z": "equity_irr",
        "format": ".1%"
      },
      "description": "Equity IRR by entry and exit multiple"
    },
    "interest_sensitivity": {
      "inputs": [
        {
          "metric": "interest_rate",
          "range": {
            "start": 0.02,
            "stop": 0.07,
            "step": 0.01
          }
        }
      ],
      "outputs": [
        "equity_irr",
        "moic",
        "equity_irr_3y"
      ],
      "plot": {
        "kind": "line",
        "x": "interest_rate",
        "y": [
          "equity_irr",
          "equity_irr_3y"
        ],
        "format": ".1%"
      },
      "description": "Returns as the base rate moves"
    },
    "leverage_sensitivity": {
      "inputs": [
        {
          "metric": "tlb_leverage",
          "values": [
            3.0,
            3.5,
            4.0,
            4.5,
            5.0
          ]
        }
      ],
      "outputs": [
        "equity_irr",
        "moic",
        "leverage@2025"
      ],
      "plot": {
        "kind": "line",
        "x": "tlb_leverage",
        "y": [
          "equity_irr"
        ],
        "format": ".1%"
      },
      "description": "Returns and opening leverage by term loan size"
    }
  },
  "checks": {
    "sources_equal_uses": {
      "expr": "total_sources - total_uses"
    },
    "balance_sheet_balances": {
      "expr": "total_assets - total_liabilities_and_equity"
    },
    "cash_above_minimum": {
      "expr": "cash >= minimum_cash - 1e-6",
      "severity": "warning"
    },
    "term_loan_not_negative": {
      "expr": "tlb_close >= -1e-9"
    }
  }
}
